{
  "version": 2,
  "flows": {
    ".gitlab/duo/flows/ctx-planning.yml": {
      "operations": [
        "ctx-project-design",
        "ctx-issue-new",
        "ctx-issue-triage",
        "ctx-spec-interview",
        "ctx-epic-new",
        "ctx-ticket-new",
        "ctx-epic-design"
      ],
      "read_only_components": [],
      "terminal_tokens": {
        "route": ["ready", "intake_done", "blocked"],
        "specification": ["ready", "blocked"],
        "decomposition": ["ready", "blocked"]
      }
    },
    ".gitlab/duo/flows/ctx-development.yml": {
      "operations": [
        "ctx-project-go",
        "ctx-project-sleep",
        "ctx-epic-run",
        "ctx-ticket-design",
        "ctx-ticket-tests",
        "ctx-ticket-start",
        "ctx-branch-agent",
        "ctx-hotfix",
        "ctx-project-fix",
        "ctx-ci-check",
        "ctx-browser-check",
        "ctx-ticket-review",
        "ctx-ticket-close",
        "ctx-epic-docs",
        "ctx-epic-review",
        "ctx-epic-close",
        "ctx-merge-queue"
      ],
      "read_only_components": [
        "review",
        "epic_review"
      ],
      "terminal_tokens": {
        "coordinate": ["design", "tests", "implementation", "browser", "integrate", "epic", "checkpoint", "blocked"],
        "design": ["ready", "blocked"],
        "tests": ["ready", "blocked"],
        "implementation": ["ready", "blocked"],
        "browser": ["ready", "blocked"],
        "review": ["ready", "blocked"],
        "integrate": ["more", "complete", "blocked"],
        "epic_review": ["ready", "blocked"],
        "close": ["ready", "blocked"]
      }
    },
    ".gitlab/duo/flows/ctx-delivery.yml": {
      "operations": [
        "ctx-security-check",
        "ctx-package",
        "ctx-environment-configure",
        "ctx-release",
        "ctx-monitor",
        "ctx-release-review"
      ],
      "read_only_components": [
        "assess"
      ],
      "terminal_tokens": {
        "assess": ["ready", "blocked"]
      }
    }
  },
  "skills": {
    "ctx-project-design": "skills/ctx-project-design/SKILL.md",
