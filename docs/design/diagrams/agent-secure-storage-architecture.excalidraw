      "index": "b03",
      "isDeleted": false,
      "lineHeight": 1.3,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Database / backup theft: no content without key authority.\nAuthorized application compromise can expose plaintext.\nBackup keys prevent instant erasure of deleted content.\nProvider policy and blind inference are separate workstreams.",
      "roughness": 0,
      "roundness": null,
      "seed": 66,
      "strokeColor": "#576c65",
