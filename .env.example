# Safe placeholders only. Never commit real values. Owner ticket in docs/design/architecture.md.
AICL_ENVIRONMENT=development
AICL_TEST_MODE=0
# Hosted product pages are an explicit production opt-in, independent of test helpers.
# Render deployment: environment=production, hosted=1, execution=render,
# HTTPS public URL, SMTP host/from, and /data/habitat.sqlite on a persistent disk.
AICL_HOSTED_WORKFLOW=0
AICL_WORKFLOW_EXECUTION_MODE=local
# Distinct random machine secrets (32+ ASCII characters), never shared with agents.
# Scheduler may dispatch due work; workers may execute jobs, never approve purchases.
AICL_SCHEDULER_TOKEN=
AICL_WORKER_TOKEN=
AICL_PUBLIC_BASE_URL=http://127.0.0.1:4173
AICL_DATABASE_URL=sqlite:///.ctx/tmp/aicl.db
AICL_SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM
AICL_IDENTITY_HMAC_KEY=CHANGE_ME_IDENTITY_32_BYTES_MIN
AICL_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
AICL_PRICE_TABLE_PATH=backend/aicl/price_table.example.json
AICL_SESSION_TTL_SECONDS=28800
AICL_MAGIC_LINK_TTL_SECONDS=900
AICL_SMTP_HOST=
AICL_SMTP_PORT=
AICL_SMTP_USERNAME=
AICL_SMTP_PASSWORD=
AICL_SMTP_FROM=
AICL_CONFIRMATION_TTL_SECONDS=300
AICL_RECONCILE_INTERVAL_SECONDS=60
AICL_HOLD_STALE_SECONDS=900
AICL_EXECUTOR_TIMEOUT_SECONDS=30
AICL_PROVIDER_MODE=fake
AICL_EXECUTOR_MODE=fake
AICL_CHAT_MODEL_MODE=fake

# Optional real scheduled PocketPlan inference. Fixed model: gpt-6-sol.
# Mock is default; this is independent of chat, executor and payment provider modes.
AICL_INFERENCE_MODE=mock
OPENAI_API_KEY=
# Per-database live API spend ceiling, including unresolved reservations ($1).
AICL_INFERENCE_MAX_SPEND_MICRO_USD=1000000

# Payment adapters: mock remains the default. Sandbox uses test money only.
# Real values belong in an ignored, private file; never paste them into agent prompts.
AICL_PAYMENT_MODE=mock
AICL_PAYPAL_CLIENT_ID=
AICL_PAYPAL_CLIENT_SECRET=
AICL_PAYPAL_MERCHANT_ID=
# Optional separate Sandbox business seller for approved agent purchases (all three or none).
AICL_PAYPAL_PURCHASE_CLIENT_ID=
AICL_PAYPAL_PURCHASE_CLIENT_SECRET=
AICL_PAYPAL_PURCHASE_MERCHANT_ID=
