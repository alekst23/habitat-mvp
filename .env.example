# Safe placeholders only. Never commit real values. Owner ticket in docs/design/architecture.md.
AICL_ENVIRONMENT=development
AICL_TEST_MODE=0
# Hosted product pages are an explicit production opt-in, independent of test helpers.
# Render deployment: environment=production, hosted=1, execution=render,
# HTTPS public URL and /data/habitat.sqlite on a persistent disk.
AICL_HOSTED_WORKFLOW=0
# Judge demo requires a private access link, then accepts any email for immediate entry.
# The address is not verified or stored; no email is sent and no email recovery exists.
# Hosted judge mode requires PayPal Sandbox; ordinary owner sign-in uses SMTP.
AICL_JUDGE_DEMO_MODE=0
# Required in judge mode: 32-128 random URL-safe characters. Share only the private
# /auth/access?token=<value> link. Keep the actual value outside source and recordings.
AICL_ACCESS_LINK_TOKEN=
AICL_WORKFLOW_EXECUTION_MODE=local
# Global, per-database Render compute estimate allowance ($1), plus a dispatch ceiling.
# Hosting, cron, bandwidth and storage charges are separate from this estimate.
AICL_RENDER_MAX_SPEND_MICRO_USD=1000000
AICL_RENDER_MAX_DISPATCHES=100
# Distinct random machine secrets (32+ ASCII characters), never shared with agents.
# Scheduler may dispatch due work; workers may execute jobs, never approve purchases.
AICL_SCHEDULER_TOKEN=
AICL_WORKER_TOKEN=
# Optional private cloud-browser runtime. Leave BOTH empty to disable sign-in.
# Use its private Render host and port; loopback is accepted only for development/test.
# The token must match BROWSER_SERVICE_TOKEN on that service and differ from all other keys.
AICL_BROWSER_SERVICE_URL=
AICL_BROWSER_SERVICE_TOKEN=
AICL_PUBLIC_BASE_URL=http://127.0.0.1:4173
# Optional private Google Sheets waitlist. Both empty disables signup.
# See docs/waitlist-google-sheets.md. Token must match the Apps Script property.
AICL_WAITLIST_WEBHOOK_URL=
AICL_WAITLIST_WEBHOOK_TOKEN=
AICL_DATABASE_URL=sqlite:///.ctx/tmp/aicl.db
AICL_SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM
AICL_IDENTITY_HMAC_KEY=CHANGE_ME_IDENTITY_32_BYTES_MIN
AICL_SECRET_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
AICL_PRICE_TABLE_PATH=backend/aicl/price_table.example.json
AICL_SESSION_TTL_SECONDS=28800
AICL_MAGIC_LINK_TTL_SECONDS=900
AICL_SMTP_HOST=
AICL_SMTP_PORT=
AICL_SMTP_USERNAME=
AICL_SMTP_PASSWORD=
AICL_SMTP_FROM=
AICL_CONFIRMATION_TTL_SECONDS=300
AICL_RECONCILE_INTERVAL_SECONDS=60
AICL_HOLD_STALE_SECONDS=900
AICL_EXECUTOR_TIMEOUT_SECONDS=30
AICL_PROVIDER_MODE=fake
AICL_EXECUTOR_MODE=fake
AICL_CHAT_MODEL_MODE=fake
# Set openai above for the interviewing/monitoring assistant (same OPENAI_API_KEY).
# Separate operator-funded allowance for all assistant calls in this database ($1).
AICL_ASSISTANT_MAX_SPEND_MICRO_USD=1000000

# AG Studio operations dashboard. License is a browser-visible vendor license, not an API secret.
# A trial/commercial license with AI entitlement is needed for the hosted AI experience.
AICL_STUDIO_LICENSE_KEY=
# Explicit opt-in for Studio's server-proxied analyst; uses OPENAI_API_KEY below.
AICL_STUDIO_AI_ENABLED=0
# Separate persistent operator-funded dashboard allowance ($1); never agent service credit.
AICL_STUDIO_AI_MAX_SPEND_MICRO_USD=1000000

# Optional real scheduled PocketPlan inference. Fixed model: gpt-6-sol.
# Mock is default; this is independent of chat, executor and payment provider modes.
AICL_INFERENCE_MODE=mock
OPENAI_API_KEY=
# Per-database live API spend ceiling, including unresolved reservations ($1).
AICL_INFERENCE_MAX_SPEND_MICRO_USD=1000000

# Payment adapters: mock remains the default. Sandbox uses test money only.
# Real values belong in an ignored, private file; never paste them into agent prompts.
AICL_PAYMENT_MODE=mock
AICL_PAYPAL_CLIENT_ID=
AICL_PAYPAL_CLIENT_SECRET=
AICL_PAYPAL_MERCHANT_ID=
# Optional separate Sandbox business seller for approved agent purchases (all three or none).
AICL_PAYPAL_PURCHASE_CLIENT_ID=
AICL_PAYPAL_PURCHASE_CLIENT_SECRET=
AICL_PAYPAL_PURCHASE_MERCHANT_ID=
